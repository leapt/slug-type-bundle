{% block leapt_slug_widget -%}
    {%- set target_ids = targets|map(t => form.parent.children[t].vars.id) -%}
    <div
        class="leapt-slug-input-group"
        {{ stimulus_controller('leapt/slug-type-bundle/slug', {
            targets: target_ids,
            alertMessage: 'alert_message'|trans({}, 'LeaptSlugType'),
            lockedIcon: locked_icon,
            unlockedIcon: unlocked_icon,
        }) }}
    >
        {{ block('form_widget') }}
        <button type="button" {{ stimulus_target('leapt/slug-type-bundle/slug', 'button') }} class="{{ button_class|default('') }}">
            {{ locked_icon|raw }}
        </button>
    </div>
{%- endblock %}
